# MiLin: net возвращён в минимальном составе (M5/M25).
#
# AF_UNIX — транспорт IPC, INET — IP/UDP/ICMP поверх wlan*/eth для
# Void-userspace (wpa_supplicant + DHCP), PACKET — AF_PACKET для EAPOL.

menuconfig NET
        bool "Networking support"
        default y
        # контракт upstream: эти три селекта — цена CONFIG_NET (v7.2)
        select NLATTR
        select GENERIC_NET_UTILS
        select BPF

if NET

config UNIX
        tristate "Unix domain sockets"
        help
          AF_UNIX: IPC-транспорт MiLin. SOCK_SEQPACKET даёт атомарные
          сообщения с границами (одно сообщение = один пакет), SCM_RIGHTS
          передаёт хэндлы между процессами. Это весь транспортный контракт
          микроядерного IPC этапа M5.

config UNIX_DIAG
        tristate
        depends on UNIX
        default n

menuconfig INET
        bool "TCP/IP networking"
        help
          IP/ICMP/UDP: DHCP и ping в госте поверх wlan*/eth.

if INET

source "net/ipv4/Kconfig"

endif # INET

source "net/packet/Kconfig"

# скрытые символы контракта: их селектит BPF_SYSCALL (kernel/bpf/Kconfig
# v7.2), а определения жили в upstream net/Kconfig, который снесён
config NET_SOCK_MSG
        bool
config NET_XGRESS
        bool
        select NET_INGRESS
        select NET_EGRESS
config PAGE_POOL
        bool
# ещё скрытые символы контракта (upstream net/Kconfig снесён)
config NET_INGRESS
        bool
config NET_EGRESS
        bool


menuconfig WIRELESS
        bool "Wireless"
        default y

if WIRELESS

source "net/wireless/Kconfig"
source "net/mac80211/Kconfig"

endif # WIRELESS

source "net/rfkill/Kconfig"

config FAILOVER
        tristate "Generic failover module"


endif # NET
