menuconfig MILIN_KDRIVER
	bool "MiLin kdriver domain"
	depends on SYSFS
	help
	  Домен драйверов «между ядром и userspace»: каждый драйвер —
	  отдельный kthread со своей очередью запросов (свой pid, свой
	  стек), userspace общается с ним через /dev/<name>: write —
	  запрос, read — ответ. Размещение выбирается политикой при
	  регистрации (AUTO -> ядро) и переключается на лету через
	  /sys/class/mlkd/<name>/placement: 'user' отдаёт драйвер
	  userspace-серверу (UIO-путь), 'kernel' возвращает в домен.

if MILIN_KDRIVER

config MILIN_KDRIVER_DEMO
	bool "kdemo: sample domain driver"
	help
	  Образец драйвера домена (echo/счётчик/инфо) и бут-тест:
	  супервизор проверяет запросы, переключение размещения и отказ
	  при 'user' (-ENODEV).

config MILIN_AMDGPU_FACADE
	bool "amdgpu-fac: GPU facade driver for the domain"
	help
	  Запросная плоскость amdgpu (M11): клиенты микроядра говорят
	  протокол mlgpu через /dev/amdgpu (write = запрос, read = ответ),
	  цикл обслуживает kthread домена. При placement=user протокол
	  уезжает в userspace-демон gpud (lane "gpu.amdgpu"). Режимы:
	  facade (amdgpu нет), amdgpu (builtin в kdrv-сборке), hw
	  (AMD-устройство найдено — точка форвардинга в DRM/TTM).

endif

config MILIN_PINDMA
	bool "MiLin pinned-DMA region for userspace drivers"
	depends on MMU
	default y
	help
	  /dev/mlpinned (M12): открытие выделяет непрерывный регион
	  4 МиБ, mmap отдаёт его процессу, ioctl(MLPIO_GETPHYS/GETSIZE)
	  возвращает физический адрес базы. Пользователь — userspace-
	  драйверы устройств с DMA (netd: кольца и буферы e1000).
