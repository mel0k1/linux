# Keep I/O buses first
source "drivers/pci/Kconfig"
# MiLin (M5): loopback — сетевой объект, на который ссылаются net/core
# (loopback_net_ops, blackhole_netdev); единственный член drivers/net,
# без которого AF_UNIX-транспорт не линкуется
source "drivers/net/Kconfig"

config PC104
        bool "PC/104 support" if EXPERT
        help
          Expose PC/104 form factor device drivers and options available for
          selection and configuration. Enable this option if your target
          machine has a PC/104 bus.

source "drivers/base/Kconfig"




source "drivers/firmware/Kconfig"

# MiLin (M9): домен драйверов между ядром и userspace
source "drivers/mlin/Kconfig"


















# input before char - char/joystick depends on it. As does USB.


